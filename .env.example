# MDK Engineering Bot — environment configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# -- Runtime --------------------------------------------------------------
# development | production. Toggles log format, hot-reload, error verbosity.
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Berlin

# -- Storage --------------------------------------------------------------
# Async postgres URL. Use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://mdk:mdk@db:5432/mdk
# Sync URL for Alembic migrations (psycopg).
DATABASE_URL_SYNC=postgresql+psycopg://mdk:mdk@db:5432/mdk
REDIS_URL=redis://redis:6379/0

# -- Secrets --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
# Web login token. The operator enters this on /web/login.
WEB_SESSION_TOKEN=change-me-to-a-long-random-token
# Internal token used by bot/scheduler to call the Core API.
INTERNAL_API_TOKEN=change-me-internal-token
# Fernet key for credential storage (placeholder for later phases).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=change-me-fernet-key

# -- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=000000:replace-me
# Numeric Telegram user id of the sole authorized operator.
AUTHORIZED_TELEGRAM_USER_ID=0

# -- Hosting --------------------------------------------------------------
BOT_DOMAIN=bot.example.com

# -- Capability config ----------------------------------------------------
OBLIGATIONS_FILE=./obligations.json
DAILY_CHECK_HOUR=8
# UUID. Stable for single-tenant MVP; do not change after first migration.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# -- API wiring (internal) ------------------------------------------------
# Used by bot to reach API inside the compose network.
INTERNAL_API_URL=http://api:8000/api/v1
