# MDK Engineering Bot — environment configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# -- Runtime --------------------------------------------------------------
# development | production. Toggles log format, hot-reload, error verbosity.
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Berlin

# -- Storage --------------------------------------------------------------
# Async postgres URL. Use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://mdk:mdk@db:5432/mdk
# Sync URL for Alembic migrations (psycopg).
DATABASE_URL_SYNC=postgresql+psycopg://mdk:mdk@db:5432/mdk
REDIS_URL=redis://redis:6379/0

# -- Secrets --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
# Web login token. The operator enters this on /web/login.
WEB_SESSION_TOKEN=change-me-to-a-long-random-token
# Internal token used by bot/scheduler to call the Core API.
INTERNAL_API_TOKEN=change-me-internal-token
# Fernet key for credential storage (placeholder for later phases).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=change-me-fernet-key

# -- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=000000:replace-me
# Numeric Telegram user id of the sole authorized operator.
AUTHORIZED_TELEGRAM_USER_ID=0

# -- Hosting --------------------------------------------------------------
BOT_DOMAIN=bot.example.com

# -- Capability config ----------------------------------------------------
OBLIGATIONS_FILE=./obligations.json
DAILY_CHECK_HOUR=8
# UUID. Stable for single-tenant MVP; do not change after first migration.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# -- API wiring (internal) ------------------------------------------------
# Used by bot to reach API inside the compose network.
INTERNAL_API_URL=http://api:8000/api/v1

# =========================================================================
# Phase 2 — finance automation. Every flag defaults OFF; the matching
# module no-ops cleanly until you enable it AND provide its credentials.
# =========================================================================

# -- Lexware Office (lexoffice) ------------------------------------------
# Master switch + bearer token. Without the key the daily 07:00 sync skips.
FEATURE_LEXWARE_SYNC=false
LEXWARE_API_KEY=
LEXWARE_API_BASE_URL=https://api.lexoffice.io/v1
LEXWARE_SYNC_HOUR=7

# -- UStVA Vorbereitung --------------------------------------------------
# Computes the quarterly preview ~7 days before each quarter end. Does
# NOT submit to ELSTER — submission stays manual in Lexware in Phase 2.
FEATURE_USTVA=false

# -- Liquidity & runway --------------------------------------------------
# A manual opening balance is required — no bank API in Phase 2.
FEATURE_LIQUIDITY=false
LIQUIDITY_OPENING_BALANCE=0
LIQUIDITY_RUNWAY_WARNING_DAYS=45
# Rate of received revenue earmarked for Steuerrücklage each month (0..1).
STEUERRUECKLAGE_RATE=0.30

# -- Mahnwesen (dunning) -------------------------------------------------
# B2B Verzugszinsen = Bundesbank Basiszinssatz + 9 pp (§ 288 (2) BGB).
# Basiszinssatz changes every January & July — review BASISZINSSATZ then.
FEATURE_DUNNING=false
BASISZINSSATZ=3.27
DUNNING_B2B_MARGIN=9.00
DUNNING_FEE_AMOUNT=40.00

# -- VIES VAT validation -------------------------------------------------
# Qualified query needs the operator's OWN VAT-ID as the requester so the
# response carries a consultation/proof number.
FEATURE_VIES=false
VIES_REQUESTER_VAT_ID=
VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/services/checkVatService

# -- DATEV year-end export -----------------------------------------------
# Generates a Buchungsstapel CSV under DATEV_EXPORT_DIR on January 15th.
# Drive upload + advisor email are Phase 3.
FEATURE_DATEV=false
DATEV_EXPORT_DIR=./data/datev
